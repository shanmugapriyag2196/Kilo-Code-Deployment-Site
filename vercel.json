{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dashboard/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "status": 200,
      "headers": { "Cache-Control": "no-cache, max-age=0" },
      "dest": "/index.html"
    }
  ]
}
